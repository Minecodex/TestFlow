{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "mode": {
      "type": "string",
      "enum": [
        "uppercase",
        "lowercase",
        "reverse",
        "identity"
      ]
    },
    "chunk_size": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    },
    "delay_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000
    }
  },
  "required": [
    "mode",
    "chunk_size",
    "delay_ms"
  ],
  "additionalProperties": false
}
