{
  "protocol": "testflow.module.v1",
  "id": "text-transform",
  "name": "Text transform",
  "version": "1.0.2",
  "description": "Real cross-language example module",
  "inputs": "schemas/inputs.json",
  "outputs": "schemas/outputs.json",
  "parameters": "schemas/parameters.json",
  "defaults": {
    "mode": "uppercase",
    "chunk_size": 3,
    "delay_ms": 0
  },
  "ui": "ui/config-panel.js",
  "ui_sdk": "testflow.ui.v1",
  "exposes_trace": true,
  "runtime": {
    "mode": "pod",
    "image": "testflow/node-text:v1.0.2-99d0a43bc2ef",
    "port": 8080,
    "code_mount": null,
    "registry_credential_id": null,
    "reuse_scope": "batch_node",
    "requires_sequential": false,
    "cpu": "500m",
    "memory": "512Mi"
  }
}
